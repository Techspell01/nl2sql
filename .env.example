# Copy this file to .env and fill in ONE key. .env is git-ignored; never commit it.
# Never put real keys in THIS file: it is meant to be shared.

# Which model service writes the SQL: groq (default, free) | gemini (free) | anthropic (paid)
NL2SQL_PROVIDER=groq

# Backup used automatically when the first provider is busy or rate-limited (none = off)
NL2SQL_FALLBACK=gemini

# Free key: https://aistudio.google.com/apikey  (Google account, no card)
GEMINI_API_KEY=

# Free key, used if you switch NL2SQL_PROVIDER=groq: https://console.groq.com/keys
GROQ_API_KEY=

# Paid, only if NL2SQL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional overrides (defaults depend on the provider)
# NL2SQL_MODEL=openai/gpt-oss-120b
# NL2SQL_EFFORT=medium
# NL2SQL_ROW_LIMIT=1000
# NL2SQL_QUERY_TIMEOUT_S=10
